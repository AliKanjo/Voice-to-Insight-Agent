# --- OpenAI (used when either backend below is set to "openai") ---
OPENAI_API_KEY=your-openai-key

# --- Google Gemini (used when UNDERSTAND_BACKEND=gemini; free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# =========================================================================
#  Two independent toggles: each stage can run in the cloud or on your machine
# =========================================================================

# --- Speech-to-text: "local" (Whisper) or "openai" (gpt-4o-transcribe) ---
TRANSCRIBE_BACKEND=local
# Only used when TRANSCRIBE_BACKEND=local. Requires: pip install faster-whisper
# tiny | base | small | medium | large-v3 ("small" or "medium" is better for Arabic dialect)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Understanding: "gemini" (Gemini 3.5 Flash-lite), "openai" (gpt-4o), or "local" (Ollama / llama.cpp) ---
UNDERSTAND_BACKEND=gemini

# Only used when UNDERSTAND_BACKEND=local. (e.g. Ollama: ollama run qwen2.5:1.5b)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:1.5b

# --- Notion (OPTIONAL) ---
# If set, classified `task` items are also pushed to your Notion database with Priority & Due Date.
NOTION_API_KEY=
NOTION_DATABASE_ID=
