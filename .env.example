# --- OpenAI (used when either backend below is set to "openai") ---
OPENAI_API_KEY=your-openai-key

# --- Google Gemini (used when UNDERSTAND_BACKEND=gemini; free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: model to retry on when GEMINI_MODEL is rate-limited/overloaded (empty = retry the same model).
GEMINI_FALLBACK_MODEL=

# =========================================================================
#  Two independent toggles: each stage can run in the cloud or on your machine
# =========================================================================

# --- Speech-to-text: "local" (Whisper) or "openai" (gpt-4o-transcribe). Default if unset: openai ---
TRANSCRIBE_BACKEND=local
# Only used when TRANSCRIBE_BACKEND=local. Requires: pip install faster-whisper
# tiny | base | small | medium | large-v3 ("small" or "medium" is better for Arabic dialect)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Understanding: "gemini" (Gemini 3.5 Flash-lite), "openai" (gpt-4o), or "local" (Ollama / llama.cpp). Default if unset: openai ---
UNDERSTAND_BACKEND=gemini

# Only used when UNDERSTAND_BACKEND=local. (e.g. Ollama: ollama run qwen2.5:1.5b)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:1.5b

# --- Notion (OPTIONAL) ---
# If set, classified `task` items are also pushed to your Notion database with Priority & Due Date.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# =========================================================================
#  Deployment / security
# =========================================================================
# HTTP Basic auth for the whole app (UI + API). REQUIRED when deployed:
# if APP_PASSWORD is empty the app is open to anyone who can reach it.
APP_USERNAME=admin
APP_PASSWORD=

# Max POSTs per minute per client IP to /api/transcribe, /api/understand and /api/rag/ask (0 = off).
# Behind a reverse proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy ip>
# so limits apply to the real client IP rather than the proxy.
RATE_LIMIT_PER_MINUTE=20

# SQLite file location. In production point this at a persistent volume,
# e.g. /var/data/insights.db — container filesystems are wiped on redeploy.
DB_PATH=./data/insights.db

# Max audio upload size in MB for /api/transcribe.
MAX_UPLOAD_MB=25

# Show real provider/exception messages to clients (handy for local demos).
# Keep false in production: details are always written to the server log.
EXPOSE_ERROR_DETAILS=false
